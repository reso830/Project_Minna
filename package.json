{
  "name": "project-minna",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Orchestrator for Spec Kit-style AI-assisted development workflows.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "next build",
    "build:cli": "npm run clean && tsc -p tsconfig.cli.json",
    "lint": "eslint .",
    "test": "npm run build:cli && npm run test:unit && npm run test:ui",
    "test:unit": "node --test \"dist/**/*.test.js\"",
    "test:ui": "node -e \"if (require('fs').existsSync('src/app') || require('fs').existsSync('pages')) process.exit(1)\" || jest --passWithNoTests",
    "start": "next start",
    "start:cli": "node dist/cli.js",
    "dev": "next dev",
    "dev:cli": "tsx src/cli.ts",
    "serve:mcp": "node dist/server/mcp.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.2.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
